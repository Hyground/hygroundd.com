# Server-only Auth.js configuration. Never prefix these with NEXT_PUBLIC_.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# PostgreSQL connection supplied by Neon or another Vercel-compatible provider.
DATABASE_URL=

# One-time operational input for `pnpm auth:bootstrap-admin`.
# Remove it from the environment immediately after the promotion succeeds.
AUTH_BOOTSTRAP_ADMIN_SUB=
